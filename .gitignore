# ==============================================================================
# Wake On LAN Controller - Git Ignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.env
.venv
env.bak/
venv.bak/

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Backups & Temporary files
*.bak
*.tmp
*.temp

# Application Logs & Diagnostics (Private / Local execution)
*.log
audit.log*
startup_debug.log

# Local user configurations & network data
machines.json
ignored.json
terms_accepted.json

# Data runtime directory
data/*.json
data/*.log
data/*.tmp
!data/.gitkeep
